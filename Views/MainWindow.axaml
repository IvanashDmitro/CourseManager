<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CourseManager.ViewModels"
        xmlns:m="using:CourseManager.Models"
        x:Class="CourseManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Система управління навчальними курсами"
        Width="1360" Height="780"
        MinWidth="1280" MinHeight="620">

    <!-- ШІ: Claude Code (Claude Opus 5.5) – доопрацювання розмітки: колонки «Наступна робота» / «Дедлайн» / «Рейтинг» / «Оцінка»,
         підказки й шаблони списків, лічильник рядків; кожен блок вікна прив'язано до своєї дочірньої ViewModel
         (DataContext="{Binding CourseEditor}" тощо, x:DataType для скомпільованих прив'язок).
         Змінено: [ЗАПОВНИТИ – що змінив або перевірив студент] -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <!-- Пошук, фільтри й сортування таблиці – головна ViewModel -->
            <TextBox Width="210" Margin="0,0,8,4"
                     PlaceholderText="Пошук за ПІБ або курсом..."
                     Text="{Binding SearchQuery}" />
            <ComboBox Width="115" Margin="0,0,8,4"
                      ItemsSource="{Binding GroupFilters}"
                      SelectedItem="{Binding SelectedGroupFilter}" />
            <ComboBox Width="135" Margin="0,0,8,4"
                      ToolTip.Tip="Фільтр за типом наступної невиконаної роботи"
                      ItemsSource="{Binding ActivityFilters}"
                      SelectedItem="{Binding SelectedActivityFilter}" />
            <ComboBox Width="185" Margin="0,0,8,4"
                      ItemsSource="{Binding SortModes}"
                      SelectedItem="{Binding SelectedSortMode}" />

            <!-- Дані та розрахунок – DataToolsViewModel -->
            <WrapPanel DataContext="{Binding DataTools}" x:DataType="vm:DataToolsViewModel" Orientation="Horizontal">
                <TextBox Width="165" Margin="0,0,6,4"
                         PlaceholderText="Шлях до JSON..."
                         ToolTip.Tip="Файл для імпорту та експорту, наприклад backup.json або data\broken_syntax.json"
                         Text="{Binding JsonFilePath}" />
                <Button Content="Імпорт JSON" Margin="0,0,6,4" Command="{Binding ImportJsonCommand}" />
                <Button Content="Експорт JSON" Margin="0,0,6,4" Command="{Binding ExportJsonCommand}" />
                <Button Content="15 000 оцінок" Margin="0,0,6,4" Command="{Binding GenerateLargeDatasetCommand}"
                        ToolTip.Tip="Великий набір для замірів T1/Tn" />
                <Button Content="Стартовий набір" Margin="0,0,6,4" Command="{Binding ResetStartDataCommand}"
                        ToolTip.Tip="Повернути 100 здобувачів зі стартовими даними" />
                <Button Content="Рейтинг T1/Tn + XML" Margin="0,0,6,4" Command="{Binding RunBenchmarkAndXmlCommand}" />
                <Button Content="Скасувати" Margin="0,0,0,4" Command="{Binding CancelOperationCommand}" />
            </WrapPanel>
        </WrapPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,330">
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding FilteredEnrollments}"
                      SelectedItem="{Binding SelectedEnrollment}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="All"
                      Margin="0,0,12,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Здобувач" Binding="{Binding Student.FullName}" Width="*" MinWidth="175" />
                    <DataGridTextColumn Header="Група" Binding="{Binding Student.Group}" Width="76" />
                    <DataGridTextColumn Header="Код" Binding="{Binding Course.Code}" Width="92" />
                    <DataGridTextColumn Header="Курс" Binding="{Binding Course.Title}" Width="*" MinWidth="80" />
                    <DataGridTextColumn Header="Наступна робота" Binding="{Binding NextActivityText}" Width="140" />
                    <DataGridTextColumn Header="Дедлайн" Binding="{Binding NextDeadlineText}" Width="165" />
                    <DataGridTextColumn Header="Рейтинг" Binding="{Binding TotalRating}" Width="84" />
                    <DataGridTextColumn Header="Оцінка" Binding="{Binding NationalGrade}" Width="114" />
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="8" Margin="0,0,14,0">

                    <!-- Керування курсами – CourseEditorViewModel -->
                    <StackPanel Spacing="8" DataContext="{Binding CourseEditor}" x:DataType="vm:CourseEditorViewModel">
                        <TextBlock Text="Керування курсами" FontWeight="Bold" />
                        <ComboBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}"
                                  PlaceholderText="Оберіть курс або введіть код нижче" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:Course">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox PlaceholderText="Код (напр. CS-101)" Text="{Binding Code}" />
                        <TextBox PlaceholderText="Назва курсу" Text="{Binding Title}" />
                        <TextBox PlaceholderText="Викладач" Text="{Binding Instructor}" />
                        <UniformGrid Columns="3">
                            <Button Content="Додати" Command="{Binding AddCommand}" Margin="0,0,4,0" HorizontalAlignment="Stretch" />
                            <Button Content="Оновити" Command="{Binding UpdateCommand}" Margin="0,0,4,0" HorizontalAlignment="Stretch" />
                            <Button Content="Видалити" Command="{Binding DeleteCommand}" HorizontalAlignment="Stretch" />
                        </UniformGrid>
                    </StackPanel>

                    <!-- Роботи курсу – ActivityEditorViewModel -->
                    <Separator />
                    <StackPanel Spacing="8" DataContext="{Binding ActivityEditor}" x:DataType="vm:ActivityEditorViewModel">
                        <TextBlock Text="Роботи курсу" FontWeight="Bold" />
                        <TextBlock Text="{Binding Info}" TextWrapping="Wrap" Foreground="#5A6270" />
                        <ComboBox ItemsSource="{Binding Activities}" SelectedItem="{Binding SelectedActivity}"
                                  PlaceholderText="Оберіть роботу, щоб змінити чи видалити" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:CourseActivity">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Тип" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Types}" SelectedItem="{Binding TypeName}"
                                      HorizontalAlignment="Stretch" />
                        </Grid>
                        <TextBox PlaceholderText="Назва роботи (напр. Лабораторна 5)" Text="{Binding Title}" />
                        <Grid ColumnDefinitions="*,*">
                            <TextBox Grid.Column="0" PlaceholderText="Макс. бал" Text="{Binding MaxScoreText}"
                                     ToolTip.Tip="Максимальний бал за роботу (більше 0, не більше 100)" Margin="0,0,6,0" />
                            <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding Deadline}"
                                                PlaceholderText="Дедлайн" HorizontalAlignment="Stretch" />
                        </Grid>
                        <TextBlock Text="{Binding ExtraLabel}" Foreground="#5A6270" />
                        <TextBox Text="{Binding ExtraText}" />
                        <UniformGrid Columns="3">
                            <Button Content="Додати" Command="{Binding AddCommand}" Margin="0,0,4,0" HorizontalAlignment="Stretch" />
                            <Button Content="Оновити" Command="{Binding UpdateCommand}" Margin="0,0,4,0" HorizontalAlignment="Stretch" />
                            <Button Content="Видалити" Command="{Binding DeleteCommand}" HorizontalAlignment="Stretch" />
                        </UniformGrid>
                    </StackPanel>

                    <!-- Керування здобувачами – StudentEditorViewModel -->
                    <Separator />
                    <StackPanel Spacing="8" DataContext="{Binding StudentEditor}" x:DataType="vm:StudentEditorViewModel">
                        <TextBlock Text="Керування здобувачами" FontWeight="Bold" />
                        <ComboBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}"
                                  PlaceholderText="Оберіть здобувача або введіть ПІБ нижче" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:Student">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox PlaceholderText="ПІБ здобувача" Text="{Binding FullName}" />
                        <TextBox PlaceholderText="Група (напр. 3РП-11)" Text="{Binding Group}" />
                        <UniformGrid Columns="3">
                            <Button Content="Додати" Command="{Binding AddCommand}" Margin="0,0,4,0" HorizontalAlignment="Stretch" />
                            <Button Content="Оновити" Command="{Binding UpdateCommand}" Margin="0,0,4,0" HorizontalAlignment="Stretch" />
                            <Button Content="Видалити" Command="{Binding DeleteCommand}" HorizontalAlignment="Stretch" />
                        </UniformGrid>
                    </StackPanel>

                    <!-- Запис на курс і оцінки – EnrollmentEditorViewModel -->
                    <Separator />
                    <StackPanel Spacing="8" DataContext="{Binding EnrollmentEditor}" x:DataType="vm:EnrollmentEditorViewModel">
                        <TextBlock Text="Запис на курс і оцінки" FontWeight="Bold" />
                        <UniformGrid Columns="2">
                            <Button Content="Записати" Command="{Binding EnrollCommand}" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                                    ToolTip.Tip="Записати обраного здобувача на обраний курс" />
                            <Button Content="Видалити запис" Command="{Binding DeleteEnrollmentCommand}" HorizontalAlignment="Stretch" />
                        </UniformGrid>
                        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Foreground="#5A6270" />
                        <ComboBox ItemsSource="{Binding Activities}" SelectedItem="{Binding SelectedActivity}"
                                  PlaceholderText="Спершу оберіть рядок у таблиці" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:CourseActivity">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" PlaceholderText="Бал" Text="{Binding ScoreText}" Margin="0,0,8,0" />
                            <CheckBox Grid.Column="1" Content="Запізн." IsChecked="{Binding IsLate}" />
                        </Grid>
                        <Button Content="Виставити оцінку" Command="{Binding AddGradeCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,220" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ShownInfo}" Foreground="#5A6270" Margin="12,0" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="18" />
        </Grid>
    </Grid>
</Window>
